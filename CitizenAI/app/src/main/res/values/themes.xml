<resources>
    <!-- Base application theme -->
    <style name="Theme.CitizenAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.CitizenAI.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A2B4A</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CitizenAI</item>
    </style>
</resources>
